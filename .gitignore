# Rust/Cargo
/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build artifacts
/dist/
*.app
*.dmg
*.zip

# Server data (player saves, etc)
server_data/

# Logs
*.log
/logs/

# Environment
.env
.env.local

# Local cargo config is normally machine-specific. Keep the shared command
# aliases while continuing to ignore any other per-machine Cargo files.
.cargo/*
!.cargo/config.toml

# Windows cross-compilation (WSL-specific)
windows_build/
BUILD_WINDOWS.md
client_data/

# Asset-creation working files: renders are regenerable Blender output (~21MB+).
asset_creation/renders/

# Blender auto-backups
*.blend1

# Python bytecode from asset_creation scripts
__pycache__/
