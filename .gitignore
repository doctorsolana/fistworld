# Rust/Cargo
/target/
/target-*/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build artifacts
/dist/
*.app
*.dmg
*.zip

# Server data (player saves, etc)
server_data/

# Logs
*.log
/logs/

# Environment
.env
.env.local

# Private deployment/operator notes (credentials and live server details)
/docs/FLY-PRIVATE.md

# Local cargo config is normally machine-specific. Keep the shared command
# aliases while continuing to ignore any other per-machine Cargo files.
.cargo/*
!.cargo/config.toml

# Windows cross-compilation (WSL-specific)
windows_build/
BUILD_WINDOWS.md
client_data/

# Regenerable asset review output, including nested building/character renders.
# Keep runtime assets and editable source .blend files tracked.
/asset_creation/**/renders/
/asset_creation/boats/.orbit/
/asset_creation/boats/.sail_states/

# Assembled inspection scenes; the source assets and preview scripts are tracked.
/asset_creation/boats/dinghy_occupied_preview.blend
/asset_creation/houses/door_lineup.blend
/asset_creation/houses/rural_review.blend

# Blender auto-backups
*.blend[0-9]*

# Python bytecode from asset_creation scripts
__pycache__/
