    // =========================================================================
    // buildings/village
    // =========================================================================
    // Built in-repo by asset_creation/houses/build_log_cabin.py, not a purchased asset.
    //
    // A HULL, not decomposition, because this is a top-down RTS: the thing units need is a footprint
    // to walk around. VHACD would spend dozens of convex pieces describing log ends and roof steps
    // that no unit can ever touch, and cost that at runtime for detail the camera never resolves.
    //
    // The Y slice is what makes a plain hull correct. Walls top out at 2.20 m of a 4.33 m total
    // (-0.16..4.17), so 0.545 cuts exactly at the eaves. Without it the hull would also enclose the
    // roof, and since the overhang stands 0.47 m proud of the walls a CONVEX hull flares outward as
    // it rises — stopping units short of the wall at head height, against thin air.
    //
    // The doorway is solid, as any hull's would be. Units path to the Anchor_Door empty and stop
    // outside, which is the intent while the interior is an empty shell.
    (
      kind: "building_log_cabin",
      gltf_path: "game_assets/buildings/village/LogCabin.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.545 ),
      collidable: true,
    ),
    // Additional house lines and upper-storey rungs. Percent is the measured
    // eave height within each exported vertical range.
    (
      kind: "building_long_cabin",
      gltf_path: "game_assets/buildings/village/LongCabin.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.439 ),
      collidable: true,
    ),
    (
      kind: "building_cabin_l2",
      gltf_path: "game_assets/buildings/village/CabinL2.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.625 ),
      collidable: true,
    ),
    (
      kind: "building_long_cabin_l2",
      gltf_path: "game_assets/buildings/village/LongCabinL2.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.633 ),
      collidable: true,
    ),
    // Same reasoning as the cabin above. Walls top out at 2.20 m of a 3.76 m total (-0.16..3.60),
    // so 0.628 cuts at the eaves. The hull covers the YARD as well as the house — the woodpile and
    // the chopping block are below the cut line and units should walk around them, not through.
    // Anchor_Door and Anchor_Work are placed to sit OUTSIDE the resulting hull; moving either the
    // block or those anchors means re-checking that, or units will path into their own collider.
    (
      kind: "building_lumberjack_hut",
      gltf_path: "game_assets/buildings/village/LumberjackHut.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.628 ),
      collidable: true,
    ),
    // Walls top out at 2.20 m of a 4.07 m total (-0.16..3.91), so 0.580 cuts at the eaves. The hull
    // takes in the farmyard (hay bales, sheaves, scythe) as well as the house, which is intended —
    // units should walk round them.
    //
    // NOTE the WHEAT FIELD is deliberately absent from this file. It is PropKind::WheatField, a
    // separate glb, and a crop field must be WALKABLE so farmers can stand in it to harvest. An
    // asset with no entry here has no collider, which is how it says so. It is also why the field
    // is not part of Farmstead.glb: the baker gathers every mesh in a scene and VertexFilter has no
    // by-name exclusion, so a field inside the building would bake as a solid 11 x 8 m block.
    // Two storeys: eaves at 4.40 m of an 8.18 m total (-0.16..8.02), so 0.558 cuts at the eaves and
    // the hull excludes the roof and the bell cupola entirely. Takes in the entrance steps and the
    // notice board, which is intended. Anchor_Door sits beyond the bottom step, outside the hull.
    // Walls top out at 2.20 m of a 3.86 m total (-0.16..3.70), so 0.611 cuts at the eaves. The hull
    // takes in the shore yard (net rack, fish line, crates, oars) as well as the hut.
    //
    // NOTE the PIER is deliberately absent from this file, exactly like the wheat field. It is
    // PropKind::FishingPier, its own glb, and units must be able to WALK OUT ALONG IT. It is also
    // why the pier is not part of FishermansHut.glb: one convex hull over a hut and a 7 m jetty
    // encloses every metre of open water between them.
    (
      kind: "building_fishermans_hut",
      gltf_path: "game_assets/buildings/village/FishermansHut.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.611 ),
      collidable: true,
    ),
    (
      kind: "building_moot_hall",
      gltf_path: "game_assets/buildings/village/MootHall.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.558 ),
      collidable: true,
    ),
    // ---------------------------------------------------------------------------------------------
    // CIVIC LADDER (L2/L3).
    //
    // `percent` is (eaves - base_y) / height, so the hull is sliced at the eaves and the roof
    // overhang does not inflate the footprint. It is DERIVED PER LEVEL, never copied: the town hall
    // carries a 6.3 m roof and a 21.6 m belfry over a 9.1 m wall, so the moot hall's 0.558 would
    // swallow most of the roof and part of the tower. The same formula reproduces the moot hall's
    // existing 0.558 from its own numbers, which is how these two were checked.
    //
    ( kind: "building_village_hall",
      gltf_path: "game_assets/buildings/village/VillageHall.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.555 ),
      collidable: true ),
    ( kind: "building_town_hall",
      gltf_path: "game_assets/buildings/village/TownHall.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.431 ),
      collidable: true ),
    // ---------------------------------------------------------------------------------------------
    // Processing industries. These slices end at the usable wall/cabin head,
    // excluding roofs and, critically, the windmill's 8.8 m animated sail
    // disc from its ground-level navigation hull.
    (
      kind: "building_windmill",
      gltf_path: "game_assets/buildings/village/WindMill.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.189 ),
      collidable: true,
    ),
    (
      kind: "building_bakery",
      gltf_path: "game_assets/buildings/village/Bakery.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.443 ),
      collidable: true,
    ),
    // Open-air public squares. Villagers must walk through the plot to reach
    // Anchor_Counter and Anchor_Trader, so neither the renderer nor the server
    // navigation cache may turn the shared 12 x 12 m footprint into a hull.
    (
      kind: "building_market",
      gltf_path: "game_assets/buildings/village/Market.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: All,
      collidable: false,
    ),
    (
      kind: "building_market_paved",
      gltf_path: "game_assets/buildings/village/MarketPaved.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: All,
      collidable: false,
    ),
    // ---------------------------------------------------------------------------------------------
    (
      kind: "building_farmstead",
      gltf_path: "game_assets/buildings/village/Farmstead.glb#Scene0",
      mode: ConvexHull,
      vertex_filter: LowerYPercent ( percent: 0.580 ),
      collidable: true,
    ),

  ],
)
