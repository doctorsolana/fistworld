// Fixed presentation town for the approved 2026-09-11 art direction.
// The fixture README records its authored changes to a real Village Lab layout.
(
    version: 1,
    name: "town-art-direction",
    map: "town_art_study",
    output_dir: "logs/captures/town-art-direction",
    resolution: (1920, 1200),
    target: scene,
    show_window: false,
    fixed_delta_seconds: 0.016666667,
    warmup_frames: 240,
    readiness: (
        minimum_frames: 90,
        maximum_frames: 1800,
        minimum_loaded_chunks: 25,
        stable_loaded_chunk_frames: 20,
    ),
    environment: {
        "FISTFORCE_CAPTURE_TOWN_SNAPSHOT": "capture/fixtures/town-art-direction.json",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
        "FISTFORCE_CAPTURE_FIT_TOWN_DRESSING": "1",
    },
    shots: [
        (name: "01-town", focus: (-105.0, 16.0, 93.0), yaw: 2.75,
         zoom: 140.0, time_of_day: 0.45,
         assertions: [settlements_at_least(count: 1), settlement_buildings_at_least(count: 65)]),
        (name: "02-surroundings", focus: (-100.0, 16.0, 115.0), yaw: 2.75,
         zoom: 205.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "03-reverse", focus: (-100.0, 16.0, 96.0), yaw: -0.4,
         zoom: 140.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "04-neighborhood", focus: (-124.0, 17.0, 79.0), yaw: 2.75,
         zoom: 70.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "05-farm-near", focus: (-75.0, 15.2, 43.7), yaw: 2.75,
         zoom: 32.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "06-farm-reverse", focus: (-75.0, 15.2, 43.7), yaw: -0.4,
         zoom: 32.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "07-yard-detail", focus: (-140.0, 18.8, 52.0), yaw: -0.5,
         zoom: 27.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "08-town-evening", focus: (-105.0, 16.0, 93.0), yaw: 2.75,
         zoom: 140.0, time_of_day: 0.72,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "09-town-afternoon", focus: (-105.0, 16.0, 93.0), yaw: 2.75,
         zoom: 140.0, time_of_day: 0.60,
         assertions: [settlement_buildings_at_least(count: 65)]),
        (name: "10-neighborhood-night", focus: (-124.0, 17.0, 79.0), yaw: 2.75,
         zoom: 70.0, time_of_day: 0.90,
         assertions: [settlement_buildings_at_least(count: 65)]),
    ],
)
