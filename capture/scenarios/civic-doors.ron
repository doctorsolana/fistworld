// Continuous open/close proof through the real replicated-door-demand consumer.
(
    version: 1,
    name: "civic-doors",
    map: "village_lab",
    output_dir: "logs/captures/civic-doors",
    resolution: (1600, 1000),
    fixed_delta_seconds: 0.016666667,
    target: scene,
    show_window: false,
    warmup_frames: 300,
    readiness: (
        minimum_frames: 90,
        maximum_frames: 1200,
        minimum_loaded_chunks: 25,
        stable_loaded_chunk_frames: 20,
    ),
    continuous: true,
    probe_every: 30,
    environment: {
        "FISTFORCE_CAPTURE_HALLS": "lineup",
        "FISTFORCE_CAPTURE_DOORS": "cycle",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "door-000", focus: (-15.0, 0.0, -15.0), yaw: 3.10, zoom: 70.0, time_of_day: 0.43, assertions: [settlements_at_least(count: 3)]),
