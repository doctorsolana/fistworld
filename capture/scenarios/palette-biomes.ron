// Exact close cameras from forest-floor.ron and meadow-trees.ron.
// Clear clouds isolate the global palette from cloud-shadow timing.
(
    version: 1,
    name: "palette-biomes",
    map: "big_world",
    output_dir: "logs/captures/palette-biomes",
    resolution: (1600, 900),
    fixed_delta_seconds: 0.016666667,
    target: scene,
    show_window: false,
    warmup_frames: 300,
    readiness: (minimum_frames: 90, maximum_frames: 1200,
        minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 20),
    environment: { "FISTFORCE_CAPTURE_CLOUDS": "clear" },
    diagnostics: (performance_overlay: false, gizmos: false, render_timings: false),
    shots: [
        (name: "forest-close", focus: (-3000.0, 0.0, -260.0),
         yaw: -0.45, zoom: 52.0, time_of_day: 0.5,
         assertions: [loaded_chunks_at_least(count: 64), entities_at_least(count: 100)]),
        (name: "meadow-close", focus: (-2920.0, 0.0, -660.0),
         yaw: -0.45, zoom: 60.0, time_of_day: 0.5,
         assertions: [loaded_chunks_at_least(count: 64)]),
    ],
)
