// Real production UI: open, hover, tab actions, close, reopen. See capture/ui_tour.rs.
(
 version:1, name:"ui-theme-tour", map:"battle_lab",
 output_dir:"logs/captures/ui-theme/tour", resolution:(1600,900),
 fixed_delta_seconds:0.016666667, target:window, show_window:false,
 continuous:true, probe_every:3, warmup_frames:180,
 readiness:(minimum_frames:90, maximum_frames:1200, minimum_loaded_chunks:25, stable_loaded_chunk_frames:20),
 environment:{"FISTFORCE_CAPTURE_ENCYCLOPEDIA":"people", "FISTFORCE_CAPTURE_UI_TOUR":"1",
              "FISTFORCE_CAPTURE_HERO":"default", "FISTFORCE_CAPTURE_HERO_OFFSET":"0,0",
              "FISTFORCE_CAPTURE_SETTLEMENT":"village"},
