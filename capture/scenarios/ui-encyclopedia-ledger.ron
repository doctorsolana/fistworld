// Five production tabs, native typography, authored art and actual character appearances.
// Offline facts exercise presentation; connected labs still own authoritative actions.
(
    version: 1,
    name: "encyclopedia-ledger",
    map: "village_lab",
    output_dir: "logs/captures/ui-encyclopedia-ledger",
    resolution: (1600, 1000),
    target: window,
    show_window: false,
    warmup_frames: 180,
    readiness: (minimum_frames: 60, maximum_frames: 1800, minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 20),
    environment: {
        "FISTFORCE_CAPTURE_HUD": "play",
        "FISTFORCE_CAPTURE_HERO": "default",
        "FISTFORCE_CAPTURE_HERO_OFFSET": "20,0",
        "FISTFORCE_CAPTURE_SELECT": "1",
        "FISTFORCE_CAPTURE_SETTLEMENT": "village",
        "FISTFORCE_CAPTURE_ENCYCLOPEDIA": "companies",
        "FISTFORCE_CAPTURE_ENCYCLOPEDIA_TOUR": "1",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "01-people", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "02-places", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "03-retinue", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "04-army", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "05-companies", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "06-own-record", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "07-people-warm", focus: (0.0, 0.0, 0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
    ],
)
