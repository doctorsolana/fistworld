// One uninterrupted animation sequence, with probes every six rendered frames.
(
    name: "character-work",
    output_dir: "logs/captures/character-work",
    version: 1,
    map: "village_lab",
    resolution: (1600, 900),
    fixed_delta_seconds: 0.016666667,
    target: scene,
    show_window: false,
    warmup_frames: 300,
    readiness: (
        minimum_frames: 90,
        maximum_frames: 1200,
        minimum_loaded_chunks: 25,
        stable_loaded_chunk_frames: 20,
    ),
    continuous: true,
    probe_every: 6,
    environment: {
        "FISTFORCE_CAPTURE_ACTIVITY": "build,chop,farm,fish,mine",
        "FISTFORCE_CAPTURE_HERO_OFFSET": "-2.8,0",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "work-00", focus: (-15.0, 0.0, -15.0), yaw: -0.2, zoom: 15.0, time_of_day: 0.5, assertions: [entities_at_least(count: 100)]),
        (name: "work-01", focus: (-15.0, 0.0, -15.0), yaw: -0.2, zoom: 15.0, time_of_day: 0.5, assertions: [entities_at_least(count: 100)]),
