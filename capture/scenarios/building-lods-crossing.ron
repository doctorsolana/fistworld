// Compact, every-frame colour/geometry proof through production building LOD swaps.
// Fixed focus/yaw, clear noon lighting; no forced LOD and no map-view unload.
// 151 frames at 60Hz: close -> medium -> far -> close, with short held endpoints.
// Compare the PNGs on both sides of each metadata LOD-count change. A successful
// readiness assertion alone does not detect a one-frame retained-render-bin flash.
(
    version: 1,
    name: "building-lods-crossing",
    map: "village_lab",
    output_dir: "logs/captures/building-lods-crossing",
    resolution: (1280, 900), target: scene, show_window: false,
    fixed_delta_seconds: 0.016666667,
    continuous: true, probe_every: 1, warmup_frames: 240,
    readiness: (minimum_frames: 60, maximum_frames: 1200,
                minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 12),
    environment: {
        "FISTFORCE_CAPTURE_BUILDING_LODS": "1",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
    (name: "000-close", focus: (-180.0, 0.0, 80.0), yaw: 3.5, zoom: 90.000000, time_of_day: 0.5, assertions: [building_lods_ready(count: 19)]),
