// Real rendering of staged replicated states; authoritative paid work and the
// owner button are checked in the connected house-upgrade lab.
(version: 1, name: "house-upgrade", map: "village_lab",
 output_dir: "logs/captures/house-upgrade", resolution: (1800, 1100),
 fixed_delta_seconds: 0.016666667, target: scene, show_window: false,
 warmup_frames: 180,
 readiness: (minimum_frames: 90, maximum_frames: 1800, minimum_loaded_chunks: 25, stable_loaded_chunk_frames: 20),
 environment: { "FISTFORCE_CAPTURE_HOUSE_UPGRADES": "1", "FISTFORCE_CAPTURE_CLOUDS": "clear" },
 shots: [
  (name: "01-occupied-ground-floor", focus: (-15.0, 0.0, -15.0), yaw: 2.65, zoom: 39.0, time_of_day: 0.43, assertions: [settlement_buildings_at_least(count: 2)]),
  (name: "02-materials-and-scaffold", focus: (-15.0, 0.0, -15.0), yaw: 2.65, zoom: 39.0, time_of_day: 0.43, assertions: [settlement_buildings_at_least(count: 2)]),
  (name: "03-building-occupied-home", focus: (-15.0, 0.0, -15.0), yaw: 2.65, zoom: 39.0, time_of_day: 0.43, assertions: [settlement_buildings_at_least(count: 2)]),
  (name: "04-upper-storey-complete", focus: (-15.0, 0.0, -15.0), yaw: 2.65, zoom: 39.0, time_of_day: 0.43, assertions: [settlement_buildings_at_least(count: 2)]),
  (name: "05-occupied-night", focus: (-15.0, 0.0, -15.0), yaw: 2.65, zoom: 39.0, time_of_day: 0.00, assertions: [settlement_buildings_at_least(count: 2)])
 ])
