// Production selectors and preview; .creator.json records the actual result.
// The offline new-player confirmation proves a pending-connection notice, not a voyage.
(
    name: "character-creator-new-player",
    output_dir: "logs/captures/character-creator-new-player",
    version: 1,
    map: "village_lab",
    resolution: (1600, 900),
    fixed_delta_seconds: 0.016666667,
    target: window,
    show_window: false,
    warmup_frames: 240,
    readiness: (minimum_frames: 90, maximum_frames: 1200,
                minimum_loaded_chunks: 25, stable_loaded_chunk_frames: 20),
    environment: {
        "FISTFORCE_CAPTURE_HERO_CREATOR": "1",
        "FISTFORCE_CAPTURE_CREATOR_TOUR": "1",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
