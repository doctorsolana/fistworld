// Offline facts; production book, native buttons and scroll. No transactions.
(
    version: 1,
    name: "ledger-fleet",
    map: "village_lab",
    output_dir: "logs/captures/ledger-fleet",
    resolution: (1600, 1000),
    target: window,
    show_window: false,
    warmup_frames: 180,
    readiness: (minimum_frames: 60, maximum_frames: 1800, minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 20),
    environment: {
        "FISTFORCE_CAPTURE_HUD": "play",
        "FISTFORCE_CAPTURE_HERO": "default",
        "FISTFORCE_CAPTURE_HERO_OFFSET": "20,0",
        "FISTFORCE_CAPTURE_SELECT": "1",
        "FISTFORCE_CAPTURE_SETTLEMENT": "village",
        "FISTFORCE_CAPTURE_ENCYCLOPEDIA": "companies",
        "FISTWORLD_CAPTURE_FLEET_UI": "1",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "01-fleet", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "02-shipyard", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "03-ship-route", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "04-route-edited", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "05-fleet-return", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
        (name: "06-active-ship-route", focus: (0.0,0.0,0.0), yaw: -0.45, zoom: 100.0, time_of_day: 0.5),
    ],
)
