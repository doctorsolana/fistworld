// The real exploration dial at four world headings. The companion HUD tour
// rehearses Map/Ledger clicks; these views exercise the bearing and upright N.
(
    version: 1,
    name: "medieval-compass-headings",
    map: "village_lab",
    output_dir: "logs/captures/ui-medieval-compass",
    resolution: (1600, 1000),
    target: window,
    show_window: false,
    warmup_frames: 180,
    readiness: (minimum_frames: 60, maximum_frames: 1200, minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 20),
    environment: {
        "FISTFORCE_CAPTURE_HUD": "play",
        "FISTFORCE_CAPTURE_HERO": "default",
        "FISTFORCE_CAPTURE_HERO_OFFSET": "20,0",
        "FISTFORCE_CAPTURE_SELECT": "1",
        "FISTFORCE_CAPTURE_SETTLEMENT": "village",
        "FISTFORCE_CAPTURE_NOTICES": "1",
        "FISTFORCE_CAPTURE_MEDIEVAL_HUD": "exploration",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "01-hud", focus: (0.0, 0.0, 0.0), yaw: 0.0, zoom: 100.0, time_of_day: 0.5),
        (name: "02-east", focus: (0.0, 0.0, 0.0), yaw: 1.5707964, zoom: 100.0, time_of_day: 0.5),
        (name: "03-south", focus: (0.0, 0.0, 0.0), yaw: 3.1415927, zoom: 100.0, time_of_day: 0.5),
        (name: "04-west", focus: (0.0, 0.0, 0.0), yaw: -1.5707964, zoom: 100.0, time_of_day: 0.5),
    ],
)
