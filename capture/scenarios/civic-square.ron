(
    version: 1, name: "civic-square", map: "village_lab",
    output_dir: "logs/captures/civic-square", resolution: (1600, 1000),
    fixed_delta_seconds: 0.016666667, target: scene, show_window: false, warmup_frames: 240,
    readiness: (minimum_frames: 90, maximum_frames: 1800, minimum_loaded_chunks: 25, stable_loaded_chunk_frames: 20),
    environment: {"FISTFORCE_CAPTURE_CIVIC_SQUARE": "review", "FISTFORCE_CAPTURE_CLOUDS": "clear"},
    shots: [
        (name: "hall-and-square", focus: (-100.0, 0.0, 101.0), yaw: -0.5, zoom: 115.0, time_of_day: 0.45,
         assertions: [settlements_at_least(count: 1), settlement_buildings_at_least(count: 5)]),
        (name: "market-front", focus: (-100.0, 0.0, 98.0), yaw: 2.7, zoom: 65.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 5)]),
        (name: "hall-approach", focus: (-100.0, 0.0, 98.0), yaw: 3.14159265, zoom: 50.0, pitch: Some(-0.3), eye: 18.0, time_of_day: 0.45,
         assertions: [settlement_buildings_at_least(count: 5)]),
    ],
)
