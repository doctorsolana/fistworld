(
    version: 1,
    name: "meadow-trees-lineup",
    map: "village_lab",
    output_dir: "logs/captures/meadow-trees-lineup",
    resolution: (1800, 1100),
    target: scene,
    show_window: false,
    warmup_frames: 300,
    readiness: (minimum_frames: 90, maximum_frames: 1200, minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 20),
    environment: { "FISTFORCE_CAPTURE_TREES": "lineup", "FISTFORCE_CAPTURE_CLOUDS": "clear" },
    // z=-6.5: LOD0. z=+6.5: LOD1. Maple, beech, cherry, existing oak, pine.
    shots: [
        (name: "palette", focus: (0.0, 3.0, 0.0), yaw: -0.15, zoom: 64.0, time_of_day: 0.5, assertions: [entities_at_least(count: 100)]),
        (name: "new-species", focus: (-9.0, 3.0, -6.5), yaw: 3.14, zoom: 34.0, time_of_day: 0.5),
        (name: "maple-close", focus: (-18.0, 0.0, -6.5), yaw: -0.5, zoom: 22.0, time_of_day: 0.5),
        (name: "beech-close", focus: (-9.0, 0.0, -6.5), yaw: -0.5, zoom: 25.0, time_of_day: 0.5),
        (name: "cherry-close", focus: (0.0, 0.0, -6.5), yaw: -0.5, zoom: 22.0, time_of_day: 0.5),
        (name: "reverse", focus: (-9.0, 0.0, 0.0), yaw: 2.70, zoom: 62.0, time_of_day: 0.5),
    ],
)
