// Continuous close -> town -> extreme distance -> close through production LOD selection.
(version: 1, name: "building-lods-zoom", map: "village_lab",
output_dir: "logs/captures/building-lods-zoom", resolution: (1400, 1000), target: scene, show_window: false,
continuous: true, probe_every: 15, warmup_frames: 240,
readiness: (minimum_frames: 60, maximum_frames: 1200, minimum_loaded_chunks: 64, stable_loaded_chunk_frames: 12),
environment: { "FISTFORCE_CAPTURE_BUILDING_LODS": "1", "FISTFORCE_CAPTURE_CLOUDS": "clear" },
