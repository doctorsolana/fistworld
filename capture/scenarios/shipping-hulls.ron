// Authored harbour scene and cached production hulls on village_lab.
// Offshore Cog remains a rendering specimen, not a sailing or berth proof.
(
    version: 1,
    name: "shipping-hulls",
    map: "village_lab",
    output_dir: "logs/captures/shipping-hulls",
    resolution: (1600, 1000),
    target: scene,
    show_window: false,
    fixed_delta_seconds: 0.016666667,
    warmup_frames: 120,
    readiness: (minimum_frames: 60, maximum_frames: 1800,
                minimum_loaded_chunks: 9, stable_loaded_chunk_frames: 20),
    environment: {
        "FISTWORLD_CAPTURE_SHIPPING_HULLS": "1",
        "FISTFORCE_CAPTURE_CLOUDS": "clear",
    },
    shots: [
        (name: "01-coaster-deck", focus: (277.95, 1.0, 152.0), yaw: 0.8707963,
         zoom: 15.0, time_of_day: 0.43, assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "02-coaster-waterline", focus: (289.0, 0.0, 152.0), yaw: 1.5707963,
         zoom: 18.0, pitch: Some(-0.05), eye: 0.75, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "03-coaster-stern-gangway", focus: (284.0, 0.0, 163.0), yaw: 0.503,
         zoom: 18.0, pitch: Some(0.10), eye: 2.2, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "04-cog-deck", focus: (184.95, 1.0, -150.0), yaw: -0.7,
         zoom: 20.0, time_of_day: 0.43, assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "05-cog-waterline", focus: (198.95, 0.0, -150.0), yaw: 1.5707963,
         zoom: 20.0, pitch: Some(-0.05), eye: 0.75, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "06-cog-stern", focus: (176.95, 0.0, -138.0), yaw: -0.588,
         zoom: 20.0, pitch: Some(0.10), eye: 2.3, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "07-port-ground-contact", focus: (257.0, 0.0, 136.0), yaw: 2.3561943,
         zoom: 18.0, pitch: Some(0.20), eye: 4.5, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "08-port-overview", focus: (260.0, 1.0, 152.0), yaw: 2.6707963,
         zoom: 38.0, time_of_day: 0.43, assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "09-harbour-context", focus: (261.0, 0.0, 152.0), yaw: 2.6707963,
         zoom: 65.0, time_of_day: 0.43, assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "10-office-shore-detail", focus: (259.0, 0.0, 147.0), yaw: 1.5707963,
         zoom: 18.0, pitch: Some(0.24), eye: 4.8, time_of_day: 0.43,
         assertions: [loaded_chunks_at_least(count: 9)]),
        (name: "11-office-night-glow", focus: (259.0, 0.0, 147.0), yaw: 1.5707963,
         zoom: 18.0, pitch: Some(0.24), eye: 4.8, time_of_day: 0.03,
