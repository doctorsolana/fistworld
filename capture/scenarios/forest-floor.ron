(
    version: 1,
    name: "forest-floor",
    map: "big_world",
    output_dir: "logs/captures/forest-floor",
    resolution: (1600, 900),
    fixed_delta_seconds: 0.016666667,
    target: scene,
    show_window: false,
    warmup_frames: 240,
    readiness: (
        minimum_frames: 60,
        maximum_frames: 1200,
        minimum_loaded_chunks: 64,
        stable_loaded_chunk_frames: 20,
    ),
    diagnostics: (
        performance_overlay: false,
        gizmos: false,
        render_timings: false,
    ),
    shots: [
        (
            name: "close-detail",
            // A player-scale inspection before judging the normal overview.
            focus: (-3000.0, 0.0, -260.0),
            yaw: -0.45,
            zoom: 52.0,
            time_of_day: 0.5,
            assertions: [
                loaded_chunks_at_least(count: 64),
                entities_at_least(count: 100),
            ],
        ),
        (
            name: "morning-close",
            // Shipped Showcase/91 forest probe (see find_biome_spots).
            focus: (-3000.0, 0.0, -260.0),
            yaw: -0.45,
            zoom: 90.0,
            time_of_day: 0.375,
            assertions: [
                loaded_chunks_at_least(count: 64),
                entities_at_least(count: 100),
            ],
        ),
        (
            name: "noon-overview",
            focus: (-3000.0, 0.0, -260.0),
            yaw: -0.45,
            zoom: 180.0,
            time_of_day: 0.5,
            assertions: [loaded_chunks_at_least(count: 64)],
        ),
    ],
)
