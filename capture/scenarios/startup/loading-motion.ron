// Uninterrupted native three-diamond animation. Readiness waits for real UI/assets;
// every recorded frame inspects pip fill, shape and stable group geometry.
(
    version: 1,
    name: "startup-loading-motion",
    map: "battle_lab",
    output_dir: "logs/captures/startup/loading-motion",
    resolution: (1600, 900),
    fixed_delta_seconds: 0.016666667,
    target: window,
    show_window: false,
    continuous: true,
    probe_every: 15,
    warmup_frames: 1,
    readiness: (minimum_frames: 1, maximum_frames: 1200, minimum_loaded_chunks: 0, stable_loaded_chunk_frames: 1),
    environment: {"FISTFORCE_CAPTURE_FRONTEND": "preparing"},
