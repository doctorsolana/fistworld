(
    version: 1,
    name: "cloud-shadow-diff",
    map: "village_lab",
    output_dir: "logs/perf-fundamentals/cloud-diff",
    resolution: (1400, 900),
    fixed_delta_seconds: 0.016666667,
    target: scene,
    show_window: false,
    warmup_frames: 300,
    continuous: false,
    probe_every: 15,
    environment: { "FISTFORCE_CAPTURE_CLOUDS": "cloudy" },
    shots: [
        (name: "diff", focus: (112.0, 0.0, -158.0), yaw: -0.45, zoom: 280.0, time_of_day: 0.5, assertions: [loaded_chunks_at_least(count: 64)]),
    ],
)
